+void BrowserPasskeysConfirmationDialog::updateSelectedEntry()
+{
+    m_selectedEntry = m_entrySource && !m_entrySource->isLocked() ? m_entrySource->currentSelectedEntry() : nullptr;
+    m_ui->updateButton->setEnabled(!m_selectedEntry.isNull());
+    if (!m_selectedEntry) {
+        m_ui->secondLabel->setText(tr("To add the passkey to an existing entry, select the entry in KeePassXC."));
+        return;
+    }
+
+    const auto label = (m_selectedEntry->title() + " - " + m_selectedEntry->username()).toHtmlEscaped();
+    if (m_selectedEntry->hasPasskey()) {
+        // An entry holds one passkey; KeePassXC asks again before replacing it
+        m_ui->secondLabel->setText(tr("Selected entry: %1<br>It already has a passkey for %2, which would be replaced.")
+                                       .arg(label,
+                                            m_selectedEntry->attributes()
+                                                ->value(EntryAttributes::KPEX_PASSKEY_RELYING_PARTY)
+                                                .toHtmlEscaped()));
+    } else {
+        m_ui->secondLabel->setText(tr("Selected entry: %1").arg(label));
+    }
+}
