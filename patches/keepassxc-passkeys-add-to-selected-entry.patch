+void TestPasskeys::testAddPasskeyToEntryWithPasskey()
+{
+    Database db;
+    auto* entry = new Entry();
+    entry->setGroup(db.rootGroup());
+    QVERIFY(browserService()->addPasskeyToEntry(
+        entry, "example.com", "example.com", "first", "firstId", "firstHandle", "firstKey"));
+
+    // Keeping the existing passkey stores nothing and says so
+    MessageBox::setNextAnswer(MessageBox::Cancel);
+    QVERIFY(!browserService()->addPasskeyToEntry(
+        entry, "example.org", "example.org", "second", "secondId", "secondHandle", "secondKey"));
+    QCOMPARE(entry->attributes()->value(EntryAttributes::KPEX_PASSKEY_RELYING_PARTY), QString("example.com"));
+
+    MessageBox::setNextAnswer(MessageBox::Overwrite);
+    QVERIFY(browserService()->addPasskeyToEntry(
+        entry, "example.org", "example.org", "second", "secondId", "secondHandle", "secondKey"));
+    QCOMPARE(entry->attributes()->value(EntryAttributes::KPEX_PASSKEY_RELYING_PARTY), QString("example.org"));
+}
