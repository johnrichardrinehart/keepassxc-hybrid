+
+void TestPasskeys::testGetWithClientDataHash()
+{
+    // RSA PKCS#1 v1.5 signatures are deterministic: two signatures over the same data are equal
+    const auto privateKeyPem =
+        QString(browserPasskeys()->buildCredentialPrivateKey(WebAuthnAlgorithms::RS256).privateKeyPem);
+    QVERIFY(!privateKeyPem.isEmpty());
+    const auto origin = QString("https://webauthn.io");
+    const auto id = QString("yrzFJ5lwcpTwYMOdXSmxF5b5cYQlqBMzbbU_d-oFLO8");
+    const auto requestOptions = browserMessageBuilder()->getJsonObject(PublicKeyCredentialRequestOptions.toUtf8());
+
+    // The client data a platform (browser) builds and signs over
+    QJsonObject platformOptions;
+    QCOMPARE(browserPasskeysClient()->getAssertionOptions(requestOptions, origin, &platformOptions), 0);
+    const auto platformCredential =
+        browserPasskeys()->buildGetPublicKeyCredential(platformOptions, id, {}, privateKeyPem);
+    const auto platformResponse = platformCredential["response"].toObject();
+    const auto platformClientData =
+        browserMessageBuilder()->getArrayFromBase64(platformResponse["clientDataJSON"].toString());
+    QVERIFY(!platformClientData.isEmpty());
+
+    // A hybrid (caBLE) request carries only that client data's hash, and a placeholder challenge
+    auto hybridRequest = requestOptions;
+    hybridRequest["challenge"] = QString("AAAAAAAAAAAAAAAAAAAAAA");
+    hybridRequest["clientDataHash"] =
+        browserMessageBuilder()->getBase64FromArray(browserMessageBuilder()->getSha256Hash(platformClientData));
+    QJsonObject hybridOptions;
+    QCOMPARE(browserPasskeysClient()->getAssertionOptions(hybridRequest, origin, &hybridOptions), 0);
+    const auto hybridCredential = browserPasskeys()->buildGetPublicKeyCredential(hybridOptions, id, {}, privateKeyPem);
+    const auto hybridResponse = hybridCredential["response"].toObject();
+
+    QCOMPARE(hybridResponse["signature"].toString(), platformResponse["signature"].toString());
+    QCOMPARE(hybridResponse["authenticatorData"].toString(), platformResponse["authenticatorData"].toString());
+    // KeePassXC's own client data was not signed, so it is not returned
+    QVERIFY(!hybridResponse.contains("clientDataJSON"));
+
+    // A hash of the wrong length is rejected
+    hybridRequest["clientDataHash"] = QString("AAAA");
+    QJsonObject rejectedOptions;
+    QCOMPARE(browserPasskeysClient()->getAssertionOptions(hybridRequest, origin, &rejectedOptions),
+             static_cast<int>(ERROR_PASSKEYS_INVALID_CHALLENGE));
+}
